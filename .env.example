# Atlas Cloud Hosting — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ---------------------------------------------------------------------------
# SUPABASE — Server-side only (never expose to browser)
# ---------------------------------------------------------------------------
# Found in: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# ADMIN SESSION SIGNING
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Keep this secret.
ADMIN_SESSION_SECRET=your-random-secret-min-32-chars

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://atlascloud.hosting

# ---------------------------------------------------------------------------
# REMOVED — These were previously exposed to the browser. Do not re-add.
# NEXT_PUBLIC_SUPABASE_URL      ← replaced by SUPABASE_URL (server-only)
# NEXT_PUBLIC_SUPABASE_ANON_KEY ← replaced by SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------
